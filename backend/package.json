{
  "name": "osint-backend",
  "version": "1.0.0",
  "description": "Local OSINT geopolitical intelligence dashboard backend",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:rss-lab": "node --watch scripts/rss-lab-server.js",
    "rss:probe": "node scripts/probe-rss.js",
    "rss:audit": "node scripts/audit-rss-catalog.js",
    "news:enrich": "node scripts/news-editorial-backfill.js",
    "awareness:lab": "node scripts/awareness-admission-lab.js",
    "market:watchlist:inspect": "node scripts/inspect-market-watchlist.js",
    "smoke:upstreams": "node scripts/smoke-upstreams.js",
    "smoke:llamacpp": "node scripts/smoke-llamacpp.js",
    "smoke:agent": "node scripts/agent-terminal-smoke.js --resident-model",
    "agent:observe": "node scripts/agent-shadow-observe.js",
    "check": "node scripts/check-source.js",
    "test": "node --require ./tests/testSetup.cjs --test --test-concurrency=2",
    "build": "npm run check",
    "storage:status": "node scripts/storage-status.js",
    "storage:volume-check": "node scripts/storage-volume-check.js",
    "storage:migrate": "node scripts/storage-migrate.js",
    "storage:backup": "node scripts/storage-backup.js",
    "storage:repair-009": "node scripts/storage-repair-009.js",
    "storage:inspect": "node scripts/storage-inspect.js"
  },
  "engines": {
    "node": ">=22.0.0 <27"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "better-sqlite3": "13.0.3",
    "cheerio": "1.2.0",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ws": "^8.22.0",
    "yahoo-finance2": "4.0.5"
  }
}
