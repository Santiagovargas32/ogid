# Instalación. Cadencias, cuotas y límites: config/runtimePolicy.js.
# SQLite es el almacenamiento de producción; no hay interruptores de persistencia.
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
ALLOW_LOCAL_ADMIN=1
ALLOW_LAN_ADMIN=1
ADMIN_API_TOKEN=
STORAGE_DB_PATH=data/sqlite/ogid.sqlite
MARKET_HISTORY_DIR=data/market

# Seleccionar proveedores según las credenciales disponibles. RSS no requiere clave.
NEWS_PROVIDERS=rss
NEWS_API_KEY=
GNEWS_API_KEY=
MEDIASTACK_API_KEY=
MARKET_PROVIDER=yahoo
MARKET_PROVIDER_FALLBACK=
MARKET_TWELVE_API_KEY=
AWARENESS_MODE=visible
# Identidad/contacto requerido por algunas fuentes oficiales.
AWARENESS_USER_AGENT=OGID-awareness/1.0 (+https://localhost; contact: local-operator)
# SEC automática para acciones seleccionadas. Vacío: no consulta SEC.
# Formato: OGID contacto@dominio.com
RESEARCH_SEC_USER_AGENT=

# IA heredada: none/off mientras el analista OpenCode usa AGENT_MODE.
AI_PROVIDER=none
AI_MODE=off
# NVIDIA_API_KEY= # Solo IA heredada; opcional.
# NVIDIA_MODEL_SUMMARY= # Solo IA heredada; opcional.
# NVIDIA_MODEL_REASONING= # Solo IA heredada; opcional.
# Router local utilizado por el broker de OpenCode.
LLAMACPP_BASE_URL=
LLAMACPP_API_KEY=
# LLAMACPP_MODEL_SUMMARY= # Solo IA heredada; opcional.
# LLAMACPP_MODEL_REASONING= # Solo IA heredada; opcional.
# Autoriza HTTP privado solo cuando el despliegue dispone de transporte seguro.
# LLAMACPP_ALLOW_PRIVATE_HTTP=0 # Solo IA heredada; opcional.

# Overrides opcionales de endpoints y acceso de proxy.
# NEWS_API_BASE_URL=https://newsapi.org/v2
# GNEWS_BASE_URL=https://gnews.io/api/v4
# MEDIASTACK_BASE_URL=https://api.mediastack.com/v1
# GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# MARKET_TWELVE_BASE_URL=https://api.twelvedata.com
# MARKET_YAHOO_BASE_URL=https://finance.yahoo.com
# WS_TRUSTED_PROXY_IPS=
# WS_ALLOWED_ORIGINS=
# Opcional: sustituye el catálogo SEC integrado por un catálogo propio.
# RESEARCH_SOURCES_FILE=
# RESEARCH_SIGNAL_POLICY_FILE=

# Las rutas *_STATE_FILE, *_AUDIT_FILE y RESEARCH_*_FILE del antiguo JSON
# siguen admitidas para herramientas de importación; SQLite guarda el runtime.
# Managed by npm start. off/on; no system services.
AGENT_BROKER_ENABLED=off
AGENT_OPENCODE_ENABLED=off
AGENT_WORKER_ENABLED=off
AGENT_MODE=off
AGENT_TASK_MODES={"global_intelligence_brief":"shadow","geopolitical_alert_assessment":"shadow","market_outlook_global":"shadow","instrument_outlook":"shadow","contextual_chat":"visible"}
AGENT_RUNTIME_DIR=data/agent-runtime
AGENT_OPENCODE_BINARY=data/agent-runtime/bin/opencode
AGENT_MODEL_MANIFEST=data/agent-runtime/models.json
# Modelo inicial; la selección guardada desde Administración prevalece.
AGENT_BACKGROUND_MODEL=llamacpp/qwen3-coder
OGID_OPENCODE_URL=http://127.0.0.1:4096
AGENT_BROKER_URL=http://127.0.0.1:4097
