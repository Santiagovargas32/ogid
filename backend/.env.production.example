# Production example. Edit the existing production .env manually; never copy
# this over it. Inject real admin/llama.cpp credentials locally, never in Git.
PORT=3000
HOST=127.0.0.1
ADMIN_API_TOKEN=
ALLOW_LOCAL_ADMIN=0

# No NewsAPI/GNews credentials are assumed. Add those providers only after
# injecting their keys on the production server.
NEWS_PROVIDERS=rss
NEWS_RSS_PIPELINE_MODE=legacy

# Observe official-source ingestion before making it public.
AWARENESS_MODE=shadow
AWARENESS_TIMEOUT_MS=9000

# First rollout: shadow only. Replace the fictitious host and empty key locally.
# Immediate rollback: AI_PROVIDER=none and AI_MODE=off, then restart OGID.
AI_PROVIDER=llamacpp
AI_MODE=shadow
AI_FEATURES=article-summary,country-insight,market-explanation
AI_DAILY_REQUEST_BUDGET=50
AI_DAILY_TOKEN_BUDGET=100000
AI_MAX_CONCURRENCY=1
AI_QUEUE_MAX=20
AI_MAX_JOBS_PER_CYCLE=6
AI_TIMEOUT_MS=180000
AI_MAX_RETRIES=1
AI_MAX_INPUT_CHARS=6000
AI_MAX_OUTPUT_TOKENS=4096
AI_STATE_FILE=data/ai/ai-enrichments.json
AI_BUDGET_STATE_FILE=data/ai/ai-budget.json
LLAMACPP_BASE_URL=http://<AI_SERVER_TAILSCALE_HOST>:8080/v1
LLAMACPP_API_KEY=
LLAMACPP_MODEL_SUMMARY=qwen3.8-27b
LLAMACPP_MODEL_REASONING=qwen3.8-27b
LLAMACPP_JSON_MODE=auto
# HTTP is permitted only by explicit opt-in inside the encrypted Tailscale tunnel.
LLAMACPP_ALLOW_PRIVATE_HTTP=1
DISABLE_BACKGROUND_REFRESH=0

MARKET_PROVIDER=yahoo
MARKET_PROVIDER_FALLBACK=
# Empty means the persisted data/market/watchlist-selection.json takes precedence
# after a watchlist has been saved. Inspect it with npm run market:watchlist:inspect.
MARKET_TICKERS=
MARKET_WATCHLIST_ROLLOUT=1
MARKET_TIMEOUT_MS=10000
MARKET_HISTORY_DIR=data/market
MARKET_INTRADAY_CANDLES_ENABLED=1
MARKET_INTRADAY_CANDLES_INTERVAL=5min
MARKET_INTRADAY_CANDLES_POLL_MS=900000
MARKET_INTRADAY_CANDLES_MAX_INSTRUMENTS=1

LOG_LEVEL=info
