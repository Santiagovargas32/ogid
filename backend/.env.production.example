# Mismo contrato que .env.example. No sobrescribir un .env con secretos.
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
ADMIN_API_TOKEN=
ALLOW_LOCAL_ADMIN=0
ALLOW_LAN_ADMIN=0
STORAGE_DB_PATH=data/sqlite/ogid.sqlite
MARKET_HISTORY_DIR=data/market
NEWS_PROVIDERS=rss
NEWS_API_KEY=
GNEWS_API_KEY=
MEDIASTACK_API_KEY=
MARKET_PROVIDER=yahoo
MARKET_PROVIDER_FALLBACK=
MARKET_TWELVE_API_KEY=
AWARENESS_MODE=shadow
# SEC automática para acciones seleccionadas. Vacío: no consulta SEC.
# Formato: OGID contacto@dominio.com
RESEARCH_SEC_USER_AGENT=

# IA heredada: none/off mientras el analista OpenCode usa AGENT_MODE.
AI_PROVIDER=none
AI_MODE=off
# Router local utilizado por el broker de OpenCode.
LLAMACPP_BASE_URL=
LLAMACPP_API_KEY=
# LLAMACPP_MODEL_SUMMARY= # Solo IA heredada; opcional.
# LLAMACPP_MODEL_REASONING= # Solo IA heredada; opcional.
# LLAMACPP_ALLOW_PRIVATE_HTTP=0 # Solo IA heredada; opcional.
# NVIDIA_API_KEY= # Solo IA heredada; opcional.
# NVIDIA_MODEL_SUMMARY= # Solo IA heredada; opcional.
# NVIDIA_MODEL_REASONING= # Solo IA heredada; opcional.
# Managed by npm start. off/on; no system services.
AGENT_BROKER_ENABLED=off
AGENT_OPENCODE_ENABLED=off
AGENT_WORKER_ENABLED=off
AGENT_MODE=off
AGENT_TASK_MODES={"global_intelligence_brief":"shadow","geopolitical_alert_assessment":"shadow","market_outlook_global":"shadow","instrument_outlook":"shadow","contextual_chat":"visible"}
AGENT_RUNTIME_DIR=data/agent-runtime
AGENT_OPENCODE_BINARY=data/agent-runtime/bin/opencode
AGENT_MODEL_MANIFEST=data/agent-runtime/models.json
# Modelo inicial; la selección guardada desde Administración prevalece.
AGENT_BACKGROUND_MODEL=llamacpp/qwen3-coder
OGID_OPENCODE_URL=http://127.0.0.1:4096
AGENT_BROKER_URL=http://127.0.0.1:4097
