# Production hotfix baseline. Inject ADMIN_API_TOKEN from the server's secret
# manager before enabling administrative access; never commit the real token.
PORT=3000
ADMIN_API_TOKEN=
ALLOW_LOCAL_ADMIN=0

# No NewsAPI/GNews credentials are assumed. Add those providers only after
# injecting their keys on the production server.
NEWS_PROVIDERS=rss
NEWS_RSS_PIPELINE_MODE=legacy

# Observe official-source ingestion before making it public.
AWARENESS_MODE=shadow
AWARENESS_TIMEOUT_MS=9000

AI_PROVIDER=none
AI_MODE=off
DISABLE_BACKGROUND_REFRESH=0

MARKET_PROVIDER=yahoo
MARKET_PROVIDER_FALLBACK=
# Empty means the persisted data/market/watchlist-selection.json takes precedence
# after a watchlist has been saved. Inspect it with npm run market:watchlist:inspect.
MARKET_TICKERS=
MARKET_WATCHLIST_ROLLOUT=1
MARKET_TIMEOUT_MS=10000
MARKET_HISTORY_DIR=data/market
MARKET_INTRADAY_CANDLES_ENABLED=1
MARKET_INTRADAY_CANDLES_INTERVAL=5min
MARKET_INTRADAY_CANDLES_POLL_MS=900000
MARKET_INTRADAY_CANDLES_MAX_INSTRUMENTS=1

LOG_LEVEL=info
