# Mismo contrato que .env.example. No sobrescribir un .env con secretos.
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
ADMIN_API_TOKEN=
ALLOW_LOCAL_ADMIN=0
ALLOW_LAN_ADMIN=0
STORAGE_DB_PATH=data/sqlite/ogid.sqlite
MARKET_HISTORY_DIR=data/market
NEWS_PROVIDERS=rss
NEWS_API_KEY=
GNEWS_API_KEY=
MEDIASTACK_API_KEY=
YOUTUBE_API_KEY=
MARKET_PROVIDER=yahoo
MARKET_PROVIDER_FALLBACK=
MARKET_TWELVE_API_KEY=
AWARENESS_MODE=shadow
# SEC automática para acciones seleccionadas. Vacío: no consulta SEC.
# Formato: OGID contacto@dominio.com
RESEARCH_SEC_USER_AGENT=

# Activación de IA explícita tras configurar el endpoint y sus credenciales.
AI_PROVIDER=none
AI_MODE=off
LLAMACPP_BASE_URL=
LLAMACPP_API_KEY=
LLAMACPP_MODEL_SUMMARY=
LLAMACPP_MODEL_REASONING=
LLAMACPP_ALLOW_PRIVATE_HTTP=0
NVIDIA_API_KEY=
NVIDIA_MODEL_SUMMARY=
NVIDIA_MODEL_REASONING=
