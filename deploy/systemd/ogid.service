[Unit]
Description=OGID geopolitical intelligence backend
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=exec
WorkingDirectory=%h/ogid/backend
ExecStartPre=/usr/bin/test -r %h/ogid/backend/.env
ExecStartPre=/usr/bin/mountpoint -q /srv/bitcoin
ExecStart=/usr/bin/node %h/ogid/backend/server.js
Environment=NODE_ENV=production
Environment=STORAGE_ENABLED=1
Environment=STORAGE_BUSINESS_ENABLED=1
Environment=STORAGE_QUEUE_MAX_BYTES=33554432
Environment=STORAGE_MAX_COMMAND_BYTES=8388608
Environment=STORAGE_TIMEOUT_MS=30000
Environment=STORAGE_QUEUE_TIMEOUT_MS=90000
Environment=STORAGE_SHUTDOWN_TIMEOUT_MS=180000
Environment=STORAGE_REQUIRE_IMPORT=1
Environment=NEWS_RETENTION_DAYS=365
Environment=STORAGE_DB_PATH=/srv/bitcoin/ogid/db/ogid.sqlite
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=210s
StandardOutput=append:%h/ogid/backend/data/logs/ogid.log
StandardError=inherit
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
