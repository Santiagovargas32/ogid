{
  "name": "ogid-mcp",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22 <27" },
  "scripts": {
    "start": "node src/index.js",
    "check": "node --check src/config.js && node --check src/client.js && node --check src/operations.js && node --check src/tools.js && node --check src/server.js && node --check src/index.js",
    "test": "node --test tests/*.test.js",
    "smoke": "node scripts/smoke.js",
    "inventory": "node scripts/inventory.js",
    "inventory:check": "node scripts/inventory.js --check-json",
    "inventory:json": "node scripts/inventory.js --json",
    "inventory:check-markdown": "node scripts/inventory.js --check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": { "@modelcontextprotocol/client": "2.4.0" }
}
