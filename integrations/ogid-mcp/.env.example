# Este archivo NO se carga automáticamente. Usar --env-file con Node o systemd.
OGID_BASE_URL=http://127.0.0.1:3000
OGID_TIMEOUT_MS=5000
OGID_MAX_RESPONSE_BYTES=2097152
OGID_MAX_OUTPUT_BYTES=262144
# Investigación: diez herramientas, sin credencial operador ni peticiones a proveedores.
OGID_PROFILE=research
# Verifica cada referencia en el runtime; no depende de una lista estática del checkout.
OGID_INSTRUMENT_AUTH=runtime
OGID_MAX_CONCURRENT=4
# Compatibilidad 0.1.1: usar OGID_INSTRUMENT_AUTH=allowlist y configurar IDs explícitos.
OGID_INSTRUMENT_IDS=
# Solo para una conexión operador separada; archivo JSON privado 600.
# OGID_OPERATOR_CREDENTIAL_FILE=/ABSOLUTE/PATH/operator-adapter.json
